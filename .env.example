# ==============================================================================
# PS-01: EkamVistar Real-World Asset Tokenization Platform - Environment Config
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Blockchain Gateway Mode ('mock' for zero-friction local dev/tests, 'fabric' for live network)
CHAIN_GATEWAY_MODE=mock
FABRIC_CHANNEL_NAME=rwa-channel
FABRIC_CHAINCODE_NAME=rwa
FABRIC_MSP_ID=EkamVistarMSP
FABRIC_CRYPTO_PATH=./network/organizations
FABRIC_PEER_ENDPOINT=localhost:7051

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://rwa_admin:rwa_secure_pass@localhost:5432/rwa_platform?schema=public

# Cache & Queue (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Document Storage (MinIO S3 Compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCS=rwa-evidence-vault

# Cryptographic Keys (32 bytes hex for AES-256-GCM envelope encryption - generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
PII_SALT=CHANGE_ME_PII_SALT_SECRET

# JWT Authentication (generate secrets with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_BYTE_HEX
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET_32_BYTE_HEX
REFRESH_TOKEN_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug
