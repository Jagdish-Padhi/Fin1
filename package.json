{
  "name": "rwa-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Real-World Asset (RWA) Tokenization Platform on Hyperledger Fabric",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"@rwa/web\" dev",
    "dev:api": "pnpm --filter \"@rwa/api\" dev",
    "dev:worker": "pnpm --filter \"@rwa/worker\" dev",
    "dev:all": "concurrently \"pnpm run dev:api\" \"pnpm run dev:worker\" \"pnpm run dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "prisma generate --schema=./db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./db/prisma/schema.prisma",
    "db:seed": "node ./db/seeds/seed.js",
    "fixtures": "node ./tools/fixtures/fixture-runner.js",
    "fabric:install": "bash scripts/fabric/install.sh",
    "fabric:up": "bash scripts/fabric/network-up.sh",
    "fabric:down": "bash scripts/fabric/network-down.sh",
    "fabric:cc-deploy": "bash scripts/fabric/cc-deploy.sh",
    "fabric:enroll": "node tools/identity/enroll.mjs",
    "fabric:bootstrap": "node tools/bootstrap/ledger-init.mjs",
    "fabric:all": "bash scripts/fabric/network-up.sh && bash scripts/fabric/cc-deploy.sh && node tools/identity/enroll.mjs && node tools/bootstrap/ledger-init.mjs",
    "smoke:golden": "node tools/smoke/golden-path.mjs",
    "smoke:ping": "node tools/smoke/ping.mjs",
    "smoke:live": "node tools/smoke/live-fabric-demo.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "fabric-ca-client": "^2.2.20",
    "fabric-common": "^2.2.20",
    "prettier": "^3.5.0",
    "prisma": "^6.4.1"
  },
  "packageManager": "pnpm@10.28.2"
}
