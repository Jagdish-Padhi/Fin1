# ==============================================================================
# PS-01: EkamVistar RWA Platform - Hyperledger Fabric Live Mode Environment
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Blockchain Gateway Mode ('fabric' enables live Hyperledger Fabric network)
CHAIN_GATEWAY_MODE=fabric
FABRIC_CHANNEL=rwa-channel
FABRIC_CHAINCODE=rwa
FABRIC_CONNECTION=.fabric/connection.json
FABRIC_IDENTITY_MAP=.fabric/identity-map.json

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://rwa_admin:rwa_secure_pass@localhost:5432/rwa_platform?schema=public

# Cache & Queue (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Document Storage (MinIO S3 Compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCS=rwa-evidence-vault

# Cryptographic Keys (32 bytes hex for AES-256-GCM envelope encryption)
ENCRYPTION_MASTER_KEY=4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b
PII_SALT=secure_pii_salt_ekamvistar_2026

# JWT Authentication
JWT_SECRET=8f4a1c7e9b2d5f0a3c6e8b1d4f7a0c3e5b8d1f4a7c0e3b6d9f2a5c8e1b4d7f0a
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b
REFRESH_TOKEN_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
